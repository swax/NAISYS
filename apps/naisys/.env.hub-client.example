# Minimal config for connecting to a remote hub (naisys --hub=https://...)
# API keys, spend limits, and variables are managed on the hub.

# Generate one per host in the supervisor (Hosts → select host → Access Key)
# and paste the plaintext here. The key alone identifies this NAISYS instance
# to the hub, so no hostname is needed.
HOST_ACCESS_KEY=

NAISYS_FOLDER="~/.naisys"
