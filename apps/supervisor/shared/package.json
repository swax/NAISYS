{
  "name": "@naisys/supervisor-shared",
  "version": "3.0.2",
  "description": "[internal] NAISYS Supervisor shared types and validation schemas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swax/NAISYS.git",
    "directory": "apps/supervisor/shared"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "clean": "npx rimraf dist",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "npm:publish:dryrun": "npm publish --dry-run",
    "npm:publish": "npm publish --access public"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@naisys/common": "3.0.2",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
