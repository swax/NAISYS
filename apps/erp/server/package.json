{
  "name": "@naisys/erp",
  "version": "3.0.4",
  "description": "NAISYS ERP - Web UI for AI-driven order and work management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swax/NAISYS.git",
    "directory": "apps/erp/server"
  },
  "type": "module",
  "main": "dist/erpServer.js",
  "bin": {
    "naisys-erp": "bin/naisys-erp.js"
  },
  "exports": {
    ".": "./dist/erpServer.js"
  },
  "scripts": {
    "clean": "npx rimraf dist client-dist .test-naisys",
    "dev": "tsx watch src/erpServer.ts",
    "build": "prisma generate && tsc",
    "bundle": "npx shx rm -rf client-dist && npx shx cp -r ../client/dist client-dist",
    "start": "node dist/erpServer.js",
    "type-check": "tsc --noEmit",
    "npm:publish:dryrun": "npm publish --dry-run",
    "npm:publish": "npm publish --access public",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "vitest run && npx playwright test"
  },
  "files": [
    "npm-shrinkwrap.json",
    "dist",
    "client-dist",
    "bin",
    ".env.example",
    "prisma.config.ts",
    "prisma/schema.prisma",
    "prisma/migrations",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "!dist/**/tests",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@naisys/common": "3.0.4",
    "@naisys/common-node": "3.0.4",
    "@naisys/erp-shared": "3.0.4",
    "@naisys/hub-database": "3.0.4",
    "@naisys/supervisor-database": "3.0.4",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/fastify-api-reference": "^1.75.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
