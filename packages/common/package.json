{
  "name": "@naisys/common",
  "version": "3.0.4",
  "type": "module",
  "description": "[internal] Common utilities and constants for NAISYS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swax/NAISYS.git",
    "directory": "packages/common"
  },
  "files": [
    "dist",
    "assets",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "clean": "npx rimraf dist",
    "build": "tsc",
    "test": "vitest run",
    "npm:publish:dryrun": "npm publish --dry-run",
    "npm:publish": "npm publish --access public"
  },
  "dependencies": {
    "cron-parser": "^5.10.2",
    "semver": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  }
}
